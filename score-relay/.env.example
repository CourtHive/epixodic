RELAY_PORT=8384
CORS_ORIGIN=*
STALE_MATCH_HOURS=4
PRUNE_INTERVAL_MINUTES=30

# Persistence to factory server (dormant by default)
# FACTORY_SERVER_URL=http://localhost:8383
# PERSIST_SCORES=true

# Upstream relay federation (arena → cloud)
# When set, all tracker events (score, intennse, clockSync, history) are
# forwarded to the upstream relay's /tracker namespace. The upstream relay
# does its own tick generation — ticks are NOT forwarded.
# UPSTREAM_RELAY_URL=https://courthive-nest.example.com:8384

# Projection intake (Wave 2b)
# Optional Bearer token; if set, POST /api/projection/* must include
# `Authorization: Bearer <token>`. competition-factory-server's
# ConsumerBootstrap reads SCORE_RELAY_API_KEY for the same value.
# PROJECTION_API_KEY=

# Optional UDP target for video-board payloads (sub-frame-latency renderer).
# Format: host:port. When set, every payload that hits
# /api/projection/video-board is also sent as a UDP datagram.
# VIDEO_BOARD_UDP_TARGET=192.168.1.43:9999
